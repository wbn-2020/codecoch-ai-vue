VITE_APP_TITLE=CodeCoachAI
VITE_API_BASE_URL=/api

# V4 feature gates are closed by default. Acceptance/demo environments must
# opt in explicitly and keep the backend gates in sync.
VITE_ENABLE_V4_PREVIEW=false
VITE_ENABLE_V4_EXPERIMENTS=false
VITE_ENABLE_V4_GROWTH=true
VITE_ENABLE_V4_KNOWLEDGE=false
VITE_ENABLE_V4_ADAPTIVE_PLAN=false
VITE_ENABLE_ADMIN_TRACE_COCKPIT=false

# V6 weekly report rollout gates.
VITE_ENABLE_V6_WEEKLY_REPORT=false
VITE_ENABLE_V6_WEEKLY_REPORT_AI=false
VITE_ENABLE_V6_WEEKLY_REPORT_PLAN_DRAFT=false

# V7 rollout gates. Test/acceptance builds must opt in explicitly.
VITE_ENABLE_V7_EXTERNAL_PLAN_SOURCE=false
VITE_ENABLE_V7_CAMPAIGN_WORKSPACE=false
VITE_ENABLE_V7_REAL_INTERVIEW=false
VITE_ENABLE_V7_OFFER=false
VITE_ENABLE_V7_CONTACT_ACTIVITY=false
VITE_ENABLE_V7_RESEARCH=false
VITE_ENABLE_V7_CAMPAIGN_REVIEW=false
