VITE_APP_TITLE=CodeCoachAI
VITE_API_BASE_URL=/api

# Production keeps V4 preview gates closed unless release configuration
# explicitly enables a controlled rollout. Trace Cockpit is now a released
# admin capability and remains protected by RBAC.
VITE_ENABLE_V4_PREVIEW=false
VITE_ENABLE_V4_EXPERIMENTS=false
VITE_ENABLE_V4_GROWTH=false
VITE_ENABLE_V4_KNOWLEDGE=false
VITE_ENABLE_ADMIN_TRACE_COCKPIT=true
