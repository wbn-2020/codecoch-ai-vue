VITE_APP_TITLE=CodeCoachAI
VITE_API_BASE_URL=/api

# V4 acceptance profile: enables stages 4/5/6/7 frontend entries.
VITE_ENABLE_V4_PREVIEW=true
VITE_ENABLE_V4_EXPERIMENTS=false
VITE_ENABLE_V4_GROWTH=true
VITE_ENABLE_V4_KNOWLEDGE=true
VITE_ENABLE_ADMIN_TRACE_COCKPIT=true
VITE_ENABLE_V7_CAMPAIGN_WORKSPACE=true
VITE_ENABLE_V7_REAL_INTERVIEW=true
VITE_ENABLE_V7_OFFER=true
VITE_ENABLE_V7_CONTACT_ACTIVITY=true
VITE_ENABLE_V7_RESEARCH=true
VITE_ENABLE_V7_CAMPAIGN_REVIEW=true

# V8 career campaign cockpit capabilities. Keep these aligned with Resume and AI
# Nacos feature gates for the acceptance environment.
VITE_ENABLE_V8_CAMPAIGN_COCKPIT=true
VITE_ENABLE_V8_CAMPAIGN_PULSE=true
VITE_ENABLE_V8_CAMPAIGN_PLAN=true
VITE_ENABLE_V8_CAMPAIGN_PORTFOLIO=true
VITE_ENABLE_V8_CAMPAIGN_EXPORT=true

# V9 evidence-usage feedback loop (internal test release, 2026-07-25). Frontend flag must be
# paired with resume/ai backend v9 gates below, else the page renders but APIs return empty/errors.
VITE_ENABLE_V9_EVIDENCE_LEARNING=true
