VITE_APP_TITLE=CodeCoachAI
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://127.0.0.1:18080

# Local V4 gates are explicit so frontend entries stay aligned with backend
# codecoachai.v4.features.* settings.
VITE_ENABLE_V4_PREVIEW=false
VITE_ENABLE_V4_EXPERIMENTS=false
VITE_ENABLE_V4_GROWTH=false
VITE_ENABLE_V4_KNOWLEDGE=false
VITE_ENABLE_ADMIN_TRACE_COCKPIT=false
